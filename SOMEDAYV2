<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Someday</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400;500;600;700&display=swap');
        
        :root {
            --gold: #d4af37;
            --dark-bg: #000000;
            --card-bg: #111111;
            --border-color: #222222;
            --safe-top: env(safe-area-inset-top);
            --safe-bottom: env(safe-area-inset-bottom);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg);
            color: #ffffff;
            margin: 0;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            -webkit-tap-highlight-color: transparent;
        }

        h1, h2, .font-elegant { font-family: 'Playfair Display', serif; }
        .gold-text { color: var(--gold); }
        .gold-bg { background-color: var(--gold); }

        .app-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            padding-top: var(--safe-top);
        }

        header {
            padding: 1.2rem 1rem;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(20px);
            z-index: 100;
            border-bottom: 1px solid var(--border-color);
        }

        main {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            padding-bottom: 160px;
            -webkit-overflow-scrolling: touch;
        }

        .card-plan {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            margin-bottom: 1rem;
            padding: 1.25rem;
            position: relative;
        }

        .card-aceptada { border: 1px solid var(--gold); }
        .card-realizada { border: 1px solid #064e3b; opacity: 0.8; }
        .card-reprogramada { border: 1px dotted var(--gold); }

        .nav-bar {
            position: fixed;
            bottom: 0; left: 0; right: 0;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(25px);
            border-top: 1px solid #222;
            display: flex;
            justify-content: space-around;
            padding: 0.6rem 0.4rem calc(0.6rem + var(--safe-bottom));
            z-index: 150;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #666;
            flex: 1;
            background: none;
            border: none;
        }

        .nav-item.active { color: var(--gold); }
        .nav-item i { font-size: 1.1rem; margin-bottom: 2px; }
        .nav-item span { font-size: 8px; font-weight: 600; text-transform: uppercase; }

        .fab-register {
            position: fixed;
            bottom: calc(85px + var(--safe-bottom));
            left: 50%;
            transform: translateX(-50%);
            background-color: var(--gold);
            color: black;
            height: 48px;
            padding: 0 24px;
            border-radius: 24px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
            z-index: 140;
            border: none;
        }

        .btn-action {
            min-height: 44px;
            border-radius: 12px;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            flex: 1;
        }
        .btn-gold { background-color: var(--gold); color: #000; }
        .btn-outline { border: 1px solid var(--gold); color: var(--gold); }
        .btn-danger { background-color: #2d0a0a; color: #fecaca; border: 1px solid #7f1d1d; }
        .btn-success { background-color: #064e3b; color: #6ee7b7; }

        .modal-container {
            border-radius: 24px 24px 0 0;
            padding-bottom: calc(2rem + var(--safe-bottom));
        }
        
        .hidden-app { display: none !important; }

        #loading-overlay {
            position: fixed;
            inset: 0;
            background: black;
            z-index: 5000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }

        .ai-loading {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(212, 175, 55, 0.1);
            border-top-color: var(--gold);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        input, textarea {
            background-color: #1a1a1a !important;
            border: 1px solid #333 !important;
            color: white !important;
        }
    </style>
</head>
<body>

    <div id="loading-overlay">
        <div class="ai-loading"></div>
        <p class="text-[8px] gold-text uppercase tracking-[0.3em] opacity-50">Sincronizando...</p>
    </div>

    <div id="auth-screen" class="fixed inset-0 z-[2000] bg-black flex flex-col items-center justify-center p-8 hidden">
        <div class="w-full max-w-xs text-center">
            <h1 class="text-4xl font-bold gold-text font-elegant mb-2">Someday</h1>
            <p class="text-neutral-600 text-[8px] uppercase tracking-[0.4em] mb-10">Private Experience</p>
            <input type="password" id="access-code" maxlength="4" inputmode="numeric" placeholder="••••" class="w-full py-4 mb-5 outline-none bg-neutral-900 border border-neutral-800 rounded-2xl text-center text-2xl tracking-[0.5em] gold-text">
            <button onclick="validateAccess()" class="w-full gold-bg text-black font-black py-4 rounded-2xl uppercase tracking-widest text-xs text-center">Entrar</button>
        </div>
    </div>

    <div id="app-content" class="app-container hidden-app">
        <header class="flex justify-between items-end">
            <div>
                <p id="filter-title" class="text-[9px] gold-text font-bold uppercase tracking-[0.15em] mb-1">Muro de Dates</p>
                <h1 class="text-2xl font-bold font-elegant">Someday</h1>
            </div>
            <div class="text-neutral-500 text-[8px] font-bold pb-1 uppercase tracking-widest flex flex-col items-end">
                <span id="date-count">0 PLANES</span>
            </div>
        </header>

        <main id="main-scroll">
            <div id="plans-container"></div>
            <div id="empty-state" class="hidden flex flex-col items-center justify-center py-20 text-center text-neutral-600">
                <i class="fas fa-calendar-alt text-3xl mb-4 opacity-10"></i>
                <p class="font-elegant text-base italic">Nada planeado aún</p>
            </div>
        </main>

        <button onclick="openModal()" class="fab-register">
            <i class="fas fa-plus"></i>
            <span>New Date</span>
        </button>

        <nav class="nav-bar">
            <button onclick="filterPlans('todos')" id="nav-todos" class="nav-item active">
                <i class="fas fa-layer-group"></i>
                <span>Muro</span>
            </button>
            <button onclick="filterPlans('propuesta')" id="nav-propuesta" class="nav-item">
                <i class="fas fa-lightbulb"></i>
                <span>Propuestas</span>
            </button>
            <button onclick="filterPlans('aceptada')" id="nav-aceptada" class="nav-item">
                <i class="fas fa-check-circle"></i>
                <span>Aceptadas</span>
            </button>
            <button onclick="filterPlans('realizada')" id="nav-realizada" class="nav-item">
                <i class="fas fa-heart"></i>
                <span>Realizadas</span>
            </button>
        </nav>
    </div>

    <div id="modal" class="fixed inset-0 z-[300] hidden">
        <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" onclick="closeModal()"></div>
        <div class="modal-container absolute bottom-0 left-0 right-0 bg-[#0a0a0a] p-6 max-h-[90vh] overflow-y-auto border-t border-neutral-800">
            <h2 id="modal-title" class="text-xl font-bold gold-text font-elegant uppercase tracking-tighter mb-6">NEW DATE</h2>
            
            <form id="plan-form" class="space-y-5">
                <input type="hidden" id="edit-id">
                <div>
                    <label class="text-[8px] font-bold text-neutral-500 uppercase tracking-widest block mb-2 ml-1">DATE</label>
                    <input type="text" id="title" required placeholder='Ej. "Ver película de estreno"' class="w-full px-4 py-3.5 rounded-xl bg-neutral-900 border border-neutral-800 outline-none focus:border-gold text-sm text-white">
                </div>

                <div>
                    <label class="text-[8px] font-bold text-neutral-500 uppercase tracking-widest block mb-2 ml-1">POINT</label>
                    <input type="text" id="point" required placeholder='Ej. "Cinépolis Santa Anita"' class="w-full px-4 py-3.5 rounded-xl bg-neutral-900 border border-neutral-800 outline-none focus:border-gold text-sm text-white">
                </div>

                <div>
                    <label class="text-[8px] font-bold text-neutral-500 uppercase tracking-widest block mb-2 ml-1">LINK</label>
                    <input type="url" id="link" placeholder='Ej. Un link de tiktok...' class="w-full px-4 py-3.5 rounded-xl bg-neutral-900 border border-neutral-800 outline-none focus:border-gold text-sm text-white">
                </div>

                <div>
                    <label class="text-[8px] font-bold text-neutral-500 uppercase tracking-widest block mb-2 ml-1">NOTAS</label>
                    <textarea id="details" rows="3" placeholder="Detalles de la date..." class="w-full px-4 py-3.5 rounded-xl bg-neutral-900 border border-neutral-800 outline-none focus:border-gold text-sm text-white resize-none"></textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[8px] font-bold text-neutral-500 uppercase tracking-widest block mb-2 ml-1">FECHA</label>
                        <input type="date" id="date" required class="w-full px-4 py-3.5 rounded-xl bg-neutral-900 border border-neutral-800 text-white text-xs">
                    </div>
                    <div>
                        <label class="text-[8px] font-bold text-neutral-500 uppercase tracking-widest block mb-2 ml-1">HORA</label>
                        <input type="time" id="time" class="w-full px-4 py-3.5 rounded-xl bg-neutral-900 border border-neutral-800 text-white text-xs">
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" id="submit-btn" class="w-full gold-bg text-black font-black py-4.5 rounded-xl uppercase tracking-widest text-[11px] shadow-xl flex items-center justify-center min-h-[50px]">
                        REGISTRAR DATE
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="toast" class="fixed top-8 left-1/2 -translate-x-1/2 bg-white text-black px-5 py-2.5 rounded-full text-[9px] font-black uppercase tracking-widest shadow-2xl opacity-0 transition-all z-[1000] pointer-events-none"></div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, updateDoc, deleteDoc, doc, onSnapshot, query, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        let db, auth, appId, currentUser;
        let plans = [];
        let currentFilter = 'todos';
        let unsubscribe = null;

        const init = async () => {
            try {
                const config = JSON.parse(__firebase_config);
                appId = typeof __app_id !== 'undefined' ? __app_id : 'someday-v3-final';
                const app = initializeApp(config);
                auth = getAuth(app);
                db = getFirestore(app);

                const initAuth = async () => {
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }
                };
                await initAuth();

                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        currentUser = user;
                        document.getElementById('loading-overlay').style.display = 'none';
                        if (sessionStorage.getItem('someday_auth') === 'true') enterApp();
                        else document.getElementById('auth-screen').classList.remove('hidden');
                    }
                });
            } catch (e) { console.error(e); }
        };

        window.onload = init;

        window.validateAccess = () => {
            const code = document.getElementById('access-code').value;
            if (["0611", "2705"].includes(code)) {
                sessionStorage.setItem('someday_auth', 'true');
                enterApp();
            } else showToast("CÓDIGO INCORRECTO");
        };

        function enterApp() {
            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('app-content').classList.remove('hidden-app');
            startSync();
        }

        function startSync() {
            if (!currentUser || !db) return;
            const colPath = collection(db, 'artifacts', appId, 'public', 'data', 'plans');
            unsubscribe = onSnapshot(query(colPath), (snap) => {
                plans = [];
                snap.forEach(d => plans.push({ id: d.id, ...d.data() }));
                renderPlans();
            });
        }

        function renderPlans() {
            const container = document.getElementById('plans-container');
            const empty = document.getElementById('empty-state');
            
            const filtered = plans.filter(p => {
                if (currentFilter === 'todos') return true;
                if (currentFilter === 'propuesta') return p.status === 'propuesta' || p.status === 'reprogramada';
                if (currentFilter === 'aceptada') return p.status === 'aceptada';
                if (currentFilter === 'realizada') return p.status === 'realizada';
                return p.status === currentFilter;
            }).sort((a,b) => (b.updatedAt?.toMillis() || 0) - (a.updatedAt?.toMillis() || 0));

            document.getElementById('date-count').innerText = `${filtered.length} PLANES`;
            if (filtered.length === 0) { container.innerHTML = ''; empty.classList.remove('hidden'); return; }
            empty.classList.add('hidden');

            container.innerHTML = filtered.map(plan => `
                <div class="card-plan ${plan.status === 'aceptada' ? 'card-aceptada' : ''} ${plan.status === 'realizada' ? 'card-realizada' : ''} ${plan.status === 'reprogramada' ? 'card-reprogramada' : ''}">
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-[7px] gold-text font-black uppercase tracking-widest">${plan.status === 'reprogramada' ? 'REPROGRAMADA' : plan.status}</span>
                        <div class="text-right">
                            <p class="text-[10px] text-white font-bold tracking-tighter">${plan.date}</p>
                            <p class="text-[8px] text-neutral-400 font-medium">${plan.time || ''}</p>
                        </div>
                    </div>
                    <h3 class="text-lg font-bold font-elegant text-left">${plan.title}</h3>
                    <p class="text-[9px] text-neutral-500 uppercase tracking-widest mb-2 text-left"><i class="fas fa-location-dot mr-1"></i> ${plan.point}</p>
                    
                    ${plan.link ? `
                        <div class="mt-1 mb-3">
                            <a href="${plan.link}" target="_blank" class="inline-flex items-center text-[8px] text-gold font-bold uppercase tracking-widest border-b border-gold/30 pb-0.5">
                                <i class="fas fa-link mr-1.5"></i> Ver Referencia
                            </a>
                        </div>
                    ` : ''}

                    ${plan.status === 'propuesta' || plan.status === 'reprogramada' ? `
                        <div class="flex gap-2 mt-4">
                            <button onclick="updateStatus('${plan.id}', 'aceptada')" class="btn-action btn-gold">ACEPTAR</button>
                            <button onclick="openEdit('${plan.id}')" class="btn-action btn-outline">REPROGRAMAR</button>
                            <button onclick="deletePlan('${plan.id}')" class="btn-action btn-danger">RECHAZAR</button>
                        </div>
                    ` : ''}

                    ${plan.status === 'aceptada' ? `
                        <div class="mt-4 pt-4 border-t border-white/5">
                            <p class="text-[8px] text-center text-neutral-500 mb-3 uppercase font-bold tracking-widest">¿Se realizó la date?</p>
                            <div class="flex gap-2">
                                <button onclick="updateStatus('${plan.id}', 'realizada')" class="btn-action btn-success">SÍ</button>
                                <button onclick="openEdit('${plan.id}')" class="btn-action btn-outline">REPROGRAMAR</button>
                            </div>
                        </div>
                    ` : ''}

                    ${plan.status === 'realizada' ? `
                        <div class="mt-4 pt-1 text-center">
                            <i class="fas fa-check-circle text-emerald-500 text-sm"></i>
                        </div>
                    ` : ''}
                </div>
            `).join('');
        }

        window.filterPlans = (f) => {
            currentFilter = f;
            document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
            document.getElementById(`nav-${f}`).classList.add('active');
            
            const titles = {
                'todos': 'Muro de Dates',
                'propuesta': 'Propuestas',
                'aceptada': 'Aceptadas',
                'realizada': 'Realizadas'
            };
            document.getElementById('filter-title').innerText = titles[f] || 'Dates';
            
            renderPlans();
        };

        window.openModal = () => {
            document.getElementById('modal-title').innerText = "NEW DATE";
            document.getElementById('submit-btn').innerText = "REGISTRAR DATE";
            document.getElementById('edit-id').value = "";
            document.getElementById('plan-form').reset();
            document.getElementById('modal').classList.remove('hidden');
        };

        window.closeModal = () => document.getElementById('modal').classList.add('hidden');

        window.openEdit = (id) => {
            const plan = plans.find(p => p.id === id);
            document.getElementById('modal-title').innerText = "EDITAR DATE";
            document.getElementById('submit-btn').innerText = "GUARDAR CAMBIOS";
            document.getElementById('edit-id').value = id;
            document.getElementById('title').value = plan.title;
            document.getElementById('point').value = plan.point;
            document.getElementById('link').value = plan.link;
            document.getElementById('details').value = plan.details;
            document.getElementById('date').value = plan.date;
            document.getElementById('time').value = plan.time;
            document.getElementById('modal').classList.remove('hidden');
        };

        document.getElementById('plan-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const editId = document.getElementById('edit-id').value;
            const data = {
                title: document.getElementById('title').value,
                point: document.getElementById('point').value,
                link: document.getElementById('link').value || "",
                details: document.getElementById('details').value || "",
                date: document.getElementById('date').value,
                time: document.getElementById('time').value || "",
                status: editId ? 'reprogramada' : 'propuesta',
                updatedAt: serverTimestamp()
            };

            try {
                if (editId) {
                    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'plans', editId), data);
                } else {
                    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'plans'), data);
                }
                closeModal();
                showToast("GUARDADO");
                filterPlans('propuesta');
            } catch (err) { showToast("ERROR"); }
        });

        window.updateStatus = async (id, s) => {
            await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'plans', id), { 
                status: s, 
                updatedAt: serverTimestamp() 
            });
            showToast(`MOVIDO A ${s.toUpperCase()}`);
            filterPlans(s);
        };

        window.deletePlan = async (id) => {
            await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'plans', id));
            showToast("ELIMINADO");
        };

        window.showToast = (m) => {
            const t = document.getElementById('toast');
            t.innerText = m; t.classList.remove('opacity-0');
            setTimeout(() => t.classList.add('opacity-0'), 2500);
        }
    </script>
</body>
</html>
